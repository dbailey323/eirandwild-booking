# Postgres connection string (e.g. from Neon via the Vercel Marketplace)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# The booking site's own address, used in emails and Stripe redirects
APP_URL=https://book.eirandwild.co.uk

# Stripe (use test keys sk_test_... until going live)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Emails via Resend (leave blank in development to print emails to the console)
RESEND_API_KEY=
EMAIL_FROM="Eir & Wild <bookings@eirandwild.co.uk>"
EMAIL_REPLY_TO=hello@eirandwild.co.uk

# Admin sign-in: comma-separated emails allowed into /admin, and a long random secret
ADMIN_EMAILS=hello@eirandwild.co.uk
AUTH_SECRET=change-me-to-a-long-random-string

# Protects the daily reminder job (Vercel Cron sends this as a Bearer token)
CRON_SECRET=change-me
